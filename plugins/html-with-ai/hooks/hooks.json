{ "hooks": {
  "PostToolUse": [ { "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
    "hooks": [ { "type": "command", "timeout": 10, "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hook.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hook.py\"" } ] } ],
  "Stop": [ { "hooks": [ { "type": "command", "timeout": 10, "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hook.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hook.py\"" } ] } ] } }
